# Gemini 설정 — 이 파일을 복사해 ".env" 로 만들고 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env
# .env 는 .gitignore 로 커밋에서 제외됩니다(키 노출 방지).

# Google AI Studio(aistudio.google.com/apikey) 에서 발급한 키
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# 사용할 모델 (python analyze.py --check-llm 으로 사용 가능한 모델 확인)
GEMINI_MODEL=gemini-3.5-flash
